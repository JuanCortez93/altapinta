# Supabase Postgres.
# En el dashboard: botón "Connect" (arriba). Copiá las connection strings y
# reemplazá [YOUR-PASSWORD] por la contraseña de la base (Project Settings > Database).
#
# DATABASE_URL  -> "Transaction pooler" (puerto 6543). La usa la app en Vercel.
# DIRECT_URL    -> "Session pooler" (puerto 5432). La usan las migraciones y el seed.

DATABASE_URL="postgresql://postgres.wgmglhyktnolerxmwhag:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.wgmglhyktnolerxmwhag:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Auth (se usa a partir de la Fase 1). Generá uno con: openssl rand -base64 32
AUTH_SECRET=""
